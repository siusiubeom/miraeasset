# ── 대용량 데이터 (git 제외 — 제출은 클라우드 스토리지 링크로) ─────────
# corpus: 주최측 제공 원본 공시 XML (5.3GB) — 재배포 금지 소지
# processed: 전처리 산출물 (3.6GB) — preprocess/ 스크립트로 재생성 가능
corpus/
processed/

# ── 비밀정보 ───────────────────────────────────────────────
# API 키 — 절대 커밋 금지 (.env.example 참고)
.env

# ── 로컬 환경 ──────────────────────────────────────────────
.venv/
.idea/
__pycache__/
*.pyc

# ── 임시/실험 파일 ─────────────────────────────────────────
baseline/_*.json
baseline/_*.txt

# 전처리 산출물 아카이브 (706MB — 클라우드 링크로 배포)
processed.zip
