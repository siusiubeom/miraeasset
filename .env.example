# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요.
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.

# 네이버클라우드 API 인증키 (콘솔 > 마이페이지 > 인증키 관리)
NAVER_CLOUD_ACCESS_KEY=
NAVER_CLOUD_SECRET_KEY=

# CLOVA Studio API 키 (CLOVA Studio > API 키 발급)
# 미설정 시 생성 단계는 추출식 폴백으로 동작합니다.
CLOVA_API_KEY=

# (선택) 기본값 대신 다른 모델/버전을 쓸 때 전체 URL 지정
# 기본값: https://clovastudio.stream.ntruss.com/v3/chat-completions/HCX-005
# CLOVA_ENDPOINT=
